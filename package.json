{
  "name": "botgineer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn Python by programming a robot. Real CPython in the browser; no backend.",
  "scripts": {
    "dev": "node scripts/copy-runtime.mjs && vite",
    "build": "node scripts/copy-runtime.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:v2": "playwright test --grep @v2",
    "test:stage": "playwright test beats props",
    "test:lessons": "playwright test lesson-",
    "test:reading": "playwright test reading",
    "test:practice": "playwright test practice",
    "test:workbench": "playwright test workbench",
    "test:audit": "AUDIT=1 playwright test tests/browser/collection-audit.spec.ts",
    "serve:subpath": "node scripts/serve-subpath.mjs",
    "collection": "node scripts/collection.mjs",
    "test:stress": "STRESS=1 playwright test sandbox-stress"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-codemirror": "^0.2.0",
    "@automerge/automerge-repo": "^2.5.6",
    "@automerge/automerge-repo-network-broadcastchannel": "^2.5.6",
    "@automerge/automerge-repo-network-websocket": "^2.5.6",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource/nunito": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/python": "^1.1.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pyodide": "314.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
